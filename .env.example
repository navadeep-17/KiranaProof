# Public Supabase identifiers; never use a secret in a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase backend-only secret; never commit any real value.
SUPABASE_SECRET_KEY=

# Voice: live mode requires a private key; without it use manual text entry.
# 'disabled' (default) never fabricates transcription responses.
GNANI_MODE=disabled
GNANI_API_KEY=

# Required when serving real supplier links from a release environment.
# Use exactly the public HTTPS origin, with no path or trailing slash.
# Local development may omit this and use http://localhost:3000.
APP_PUBLIC_ORIGIN=
